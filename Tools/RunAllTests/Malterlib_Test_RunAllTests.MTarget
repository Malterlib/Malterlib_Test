%Target "Exe_RunAllTests"
{
	Property
	{
		ProductName "Malterlib Run All Tests"
		MalterlibPostCopyProject "Tests"
		{
			!!MalterlibPostCopyProject ""
		}
		
	}
	Property
	{
		MalterlibLinkWithOpenSSL true
		MalterlibTargetNameType "BaseName"
	}
	
	Compile
	{
		PreprocessorDefines "DMalterlibCodeCoverage=1;DMalterlibClangPath=\"@(PlatformToolsetCompiler->GetPath())\";@(Compile.PreprocessorDefines)"
		{
			!!MalterlibCodeCoverage true
		}
	}

	Target
	{
		BaseName "RunAllTests"
		Group "TestFramework"
	}
	%Group "AllTests"
	{
		%GenerateFile "AllTests"
		{
			Property
			{
				Name "@(GeneratedDirectory)/Malterlib_Test_AllTests.cpp"
				AllTestsTemplate "		\"@(Builtin.Function->GetProperty('Property', 'MalterlibPostCopyDestination', '@(Explodee)'))@(Builtin.Function->GetProperty('Target', 'FileName', '@(Explodee)'))@(Builtin.Function->GetProperty('Target', 'FileExtension', '@(Explodee)'))\",\n"
				{
					&
					{
						!Explodee ""
						true "@(Builtin.Function->GetProperty('Property', 'MalterlibMainTest', '@(Explodee)'))"
					}
				}
				
				AllTests "@(Builtin.Function->ExplodeList('@(Workspace.AllTargets)', ';', 'AllTestsTemplate'))"

				CoverageBinariesTemplate "		\"@(Builtin.Function->GetProperty('Property', 'MalterlibPostCopyDestination', '@(Explodee)'))@(Builtin.Function->GetProperty('Target', 'FileName', '@(Explodee)'))@(Builtin.Function->GetProperty('Target', 'FileExtension', '@(Explodee)'))\",\n"
				{
					&
					{
						!Explodee ""
						|
						{
							true "@(Builtin.Function->GetProperty('Property', 'MalterlibMainTest', '@(Explodee)'))"
							true "@(Builtin.Function->GetProperty('Property', 'MalterlibHelperTest', '@(Explodee)'))"
							true "@(Builtin.Function->GetProperty('Property', 'MalterlibTestApp', '@(Explodee)'))"
							true "@(Builtin.Function->GetProperty('Property', 'MalterlibCoverageBinary', '@(Explodee)'))"
						}
					}
				}

				AllCoverageBinaries "@(Builtin.Function->ExplodeList('@(Workspace.AllTargets)', ';', 'CoverageBinariesTemplate'))"

				Contents	"ch8 const *g_AllTests[] = \n"\
							"	{\n"\
							"@(AllTests)"\
							"	}\n"\
							";\n"\
							"\n"\
							"mint g_nAllTests = sizeof(g_AllTests) / sizeof(g_AllTests[0]);\n"\
							"\n"

				Contents	"@(Contents)"\
							"ch8 const *g_AllCoverageBinaries[] = \n"\
							"	{\n"\
							"@(AllCoverageBinaries)"\
							"	}\n"\
							";\n"\
							"\n"\
							"mint g_nAllCoverageBinaries = sizeof(g_AllCoverageBinaries) / sizeof(g_AllCoverageBinaries[0]);\n"\
							"\n"
				{
					!!MalterlibCodeCoverage true
				}

				Group "@(Platform) @(Architecture) @(FullConfiguration)"
			}
		}
	}
	%Group "Source"
	{
		%File "Source/*"
	}
	
	Property
	{
		AllTestsTemplate "@(Builtin.Function->GetProperty('Target', 'Name', '@(Explodee)'));"
		{
			&
			{
				!Explodee ""
				true "@(Builtin.Function->GetProperty('Property', 'MalterlibMainTest', '@(Explodee)'))"
			}
		}
		
		AllTests "@(Builtin.Function->ExplodeList('@(Workspace.AllTargets)', ';', 'AllTestsTemplate'))"
	}
	%Dependency "Lib_Malterlib"

	%Dependency "@(AllTests)"
	{
		!!MalterlibAllTestsDependencies ""
	}
	%Dependency "@(MalterlibAllTestsDependencies)"
	{
		!MalterlibAllTestsDependencies ""
	}
}
