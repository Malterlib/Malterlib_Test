%Target "Exe_RunAllTests"
{
	Property
	{
		ProductName "Malterlib Run All Tests"
		MalterlibPostCopyProject "Tests"
		{
			!!MalterlibPostCopyProject undefined
		}
		
	}
	Property
	{
		MalterlibTargetNameType "BaseName"
	}
	
	Compile
	{
		PreprocessorDefines += ["DMalterlibCodeCoverage=1", `DMalterlibClangPath="@(PlatformToolsetCompiler->GetPath())"`]
		{
			!!MalterlibCodeCoverage true
		}
	}

	Target
	{
		BaseName "RunAllTests"
		Group "TestFramework"
	}
	%Group "AllTests"
	{
		%GenerateFile "AllTests"
		{
			Property
			{
				fg_AllTestsTemplate function(string _Target) string = ""
				fg_AllTestsTemplate =+ `		"@(GetProperty("Property", "MalterlibPostCopyDestination", _Target))@(GetProperty("Target", "FileName", _Target))@(GetProperty("Target", "FileExtension", _Target))",\n`
				{
					&
					{
						true GetProperty("Property", "MalterlibMainTest", _Target)
					}
				}
				
				AllTests define string = Workspace.AllTargets->ForEach("fg_AllTestsTemplate")

				CoverageBinariesTemplate function(string _Target) string
				CoverageBinariesTemplate =+ `		"@(GetProperty("Property", "MalterlibPostCopyDestination", _Target))@(GetProperty("Target", "FileName", _Target))@(GetProperty("Target", "FileExtension", _Target))",\n`
				{
					|
					{
						true GetProperty("Property", "MalterlibMainTest", _Target)
						true GetProperty("Property", "MalterlibHelperTest", _Target)
						true GetProperty("Property", "MalterlibTestApp", _Target)
						true GetProperty("Property", "MalterlibCoverageBinary", _Target)
					}
				}

				AllCoverageBinaries define string = Workspace.AllTargets->ForEach("CoverageBinariesTemplate")
			}
			GenerateFile
			{
				Name `@(GeneratedDirectory)/Malterlib_Test_AllTests.cpp`
				Contents	`ch8 const *g_AllTests[] = \n`\
							`	{\n`\
							`@(AllTests)`\
							`	}\n`\
							`;\n`\
							`\n`\
							`mint g_nAllTests = sizeof(g_AllTests) / sizeof(g_AllTests[0]);\n`\
							`\n`

				Contents =+	`ch8 const *g_AllCoverageBinaries[] = \n`\
							`	{\n`\
							`@(AllCoverageBinaries)`\
							`	}\n`\
							`;\n`\
							`\n`\
							`mint g_nAllCoverageBinaries = sizeof(g_AllCoverageBinaries) / sizeof(g_AllCoverageBinaries[0]);\n`\
							`\n`
				{
					!!MalterlibCodeCoverage true
				}

				Group `@(Platform) @(Architecture) @(FullConfiguration)`
			}
		}
	}
	%Group "Source"
	{
		%File "Source/*"
	}
	
	%Dependency "Lib_Malterlib"

	Property
	{
		fg_AllTestsDependenciesTemplate function(string _Test) [type(CEntity)] = []
		fg_AllTestsDependenciesTemplate =+ GetProperty("Target", "Name", _Test)
		{
			!!true GetProperty("Property", "MalterlibMainTest", _Test)
//			#Debug "TraceEval"
		}
	}
	%Dependency Workspace.AllTargets->ForEach("fg_AllTestsDependenciesTemplate")
}
