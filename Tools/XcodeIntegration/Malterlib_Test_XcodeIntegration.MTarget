%Target "Dll_TestXcodeIntegration"
{
	Property
	{
		//RealConfiguration "Release"
		ProductName "Malterlib Xcode Test Integration"
		MalterlibPostCopyProject "Tests"
		{
			!!MalterlibPostCopyProject undefined
		}
	}
	Property
	{
		MalterlibBundleDebugLogation MalterlibOriginalModulePath
		MalterlibXcodePrincipalClass "MalterlibTestLoader"
	}
	
	Target
	{
		Type "XcodeBundle"
		BaseName "TestXcodeIntegration"
		FileName "TestXcodeIntegration"
		FileExtension ".xctest"
		ProductType "com.apple.product-type.bundle.unit-test"
		GenerateScheme true
		LinkWithLibraries += [["-framework", "XCTest"]]
		Group "TestFramework"
	}
	Compile
	{
		PreprocessorDefines += `DMalterlibTestDeployPath="@(MalterlibDeployRoot)/@(MalterlibPostCopyProject)"`
	}
	%Group "AllTests"
	{
		%GenerateFile "AllTests"
		{
			Property
			{
				fg_AllTestsTemplate function(string _Target) string = ""
				fg_AllTestsTemplate =+ `		"@(GetProperty("Property", "MalterlibPostCopyDestination", _Target))@(GetProperty("Target", "FileName", _Target))@(GetProperty("Target", "FileExtension", _Target))",\n`
				{
					!!true GetProperty("Property", "MalterlibMainTest", _Target)
				}
				
				AllTests define string = Workspace.AllTargets->ForEach("fg_AllTestsTemplate")
			}
			GenerateFile
			{
				Name `@(GeneratedDirectory)/Malterlib_Test_AllTests.cpp`
				Contents	`ch8 const *g_AllTests[] = \n`\
							`	{\n`\
							`@(AllTests)`\
							`	}\n`\
							`;\n`\
							`\n`\
							`mint g_nAllTests = sizeof(g_AllTests) / sizeof(g_AllTests[0]);\n`\
							`\n`
				
				Group `@(Platform) @(Architecture) @(FullConfiguration)`
			}
		}
	}
	%Group "Source"
	{
		%File "Source/*"
	}
	
	%Dependency "Lib_Malterlib"

	Property
	{
		fg_AllTestsDependenciesTemplate function(string _Target) [type(CEntity)] = []
		fg_AllTestsDependenciesTemplate =+ GetProperty("Target", "Name", _Target)
		{
			!!true GetProperty("Property", "MalterlibMainTest", _Target)
		}
	}
	%Dependency Workspace.AllTargets->ForEach("fg_AllTestsDependenciesTemplate")
}
