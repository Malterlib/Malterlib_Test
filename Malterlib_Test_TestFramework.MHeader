Property
{
	MalterlibTestMain: string = "Tools/Tester/Source/Main.cpp"->MakeAbsolute()

	MalterlibEnableInternalTests: bool = false // User(Tests)=true: Enable internal Malterlib tests
	MalterlibSeparateTestWorkspaces: one_of(bool, [string]) = false // User(Tests)=true: Enable generation of separate workspaces for all tests, either true for all tests, or list the test you want to be separate
	MalterlibXcodeIntegration: bool = false // User(Tests)=true: Enable Xcode testing integration

	MalterlibInternalTestHelperTarget: bool = false
	MalterlibInternalTestHelperTarget true
	{
		!!Target:Target.Name ~"*_Test_Malterlib_Helper_*"
	}

	MalterlibInternalTestTarget: bool = false
	MalterlibInternalTestTarget true
	{
		&
		{
			!MalterlibInternalTestHelperTarget true
			Target:Target.Name ~"*_Test_Malterlib_*"
		}
	}
}

Property
{
	MalterlibMainTest: bool = false
	MalterlibHelperTest: bool = false

	MalterlibTest: bool
	MalterlibTest true
	{
		&
		{
			MalterlibTest undefined
			|
			{
				MalterlibHelperTest true
				MalterlibMainTest true
			}
		}
	}
	MalterlibTest false
	{
		!!MalterlibTest undefined
	}

	MalterlibTests: [type(CEntity)] = []
	MalterlibTestFiles: [type(CEntity)] = []
	MalterlibTestExtraGroups: [string] = []
	MalterlibTestOwnMain: bool = false
	MalterlibTestDependencies: [type(CEntity)] = []
}

%Target MalterlibTests
{
	Property
	{
		MalterlibPostCopyProject "Tests"
		{
			!!MalterlibPostCopyProject undefined
		}
		ProductName `Test @(Target:this.Identity->Replace("_", " "))`
		MalterlibTest true
		{
			!!MalterlibTest undefined
		}
		MalterlibHelperTest true
		{
			&
			{
				MalterlibHelperTest undefined
				MalterlibInternalTestHelperTarget true
			}
		}
		MalterlibMainTest true
		{
			&
			{
				MalterlibMainTest undefined
				!MalterlibHelperTest true
			}
		}
		MalterlibBuildSystemEmbedCMake false
		MalterlibTargetNameType "Normal"
	}
	Property
	{
		!!MalterlibInternalTestTarget true
		!!MalterlibInternalTestHelperTarget true

		MalterlibExeIcon `@(Builtin.BasePathAbsolute)/Malterlib/Core/Resources/MSVC/icon1.ico`
		{
			!!PlatformFamily "Windows"
		}
		MalterlibMemoryManager_Debug_EnableMemoryLeaks true
		MalterlibNoShortcuts true
	}
	Target
	{
		Type "ConsoleExecutable"
		BaseName `Test_@(Target:this.Identity)`
		ExtraGroups =+ MalterlibTestExtraGroups
		ExtraGroups =+ MalterlibTestExtraGroups_@(Target:this.Identity)
		{
			!!true IsDefined(`MalterlibTestExtraGroups_@(Target:this.Identity)`)
		}
		DebuggerCommandArguments ["--test"]
		DebuggerCommandArguments ["--test", "--groups", "Performance"]
		{
			!!Tests "Perf Tests"
		}
		Group "Tests"
		{
			!!MalterlibMainTest true
		}
		Group "Helpers"
		{
			!MalterlibMainTest true
		}
	}
	Compile
	{
		!!CompileDialect "C"
		PrefixHeader "Tools/Tester/Source/PCH.h"->MakeAbsolute()
		{
			|
			{
				Compile.Type "C++"
				!GeneratorFamily "VisualStudio"
			}
		}
		PreprocessorDefines += "DMalterlibEnableThirdPartyComparisonTests"
		{
			!!MalterlibEnableThirdPartyComparisonTests true
		}
	}
	%Group "Source"
	{
		%File MalterlibTestMain
		{
			!MalterlibTestOwnMain true
		}
		%File "Tools/Tester/Source/PCH.h"
	}
	%Group "Tests"
	{
		%File MalterlibTestFiles
		%File MalterlibTestFiles_@(Target:this.Identity)
		{
			!!true IsDefined(`MalterlibTestFiles_@(Target:this.Identity)`)
		}
	}
	Property
	{
		TestDependencies: [type(CEntity)]
		TestDependencies MalterlibTestDependencies
		TestDependencies =+ MalterlibTestDependencies_@(Target:this.Identity)
		{
			!!true IsDefined(`MalterlibTestDependencies_@(Target:this.Identity)`)
		}
	}

	%Dependency TestDependencies
	%Dependency "Lib_Malterlib"
	%Dependency "Lib_Malterlib_Test"
}

Property
{
	MalterlibTestAutoAddTarget: bool
	MalterlibTestAutoAddTarget MalterlibTestAutoAdd_@(Target:this.Identity)
	{
		!!true IsDefined(`MalterlibTestAutoAdd_@(Target:this.Identity)`)
	}
	MalterlibTestAutoAddTarget true
	{
		!!MalterlibTestAutoAddTarget undefined
	}

	MalterlibTestAutoAddWorkspace: bool
	MalterlibTestAutoAddWorkspace MalterlibTestAutoAdd_@(Workspace:this.Identity)
	{
		!!true IsDefined(`MalterlibTestAutoAdd_@(Workspace:this.Identity)`)
	}
	MalterlibTestAutoAddWorkspace true
	{
		!!MalterlibTestAutoAddWorkspace undefined
	}
}

Import "Tools/RunAllTests/Malterlib_Test_RunAllTests.MTarget"
Import "Tools/XcodeIntegration/Malterlib_Test_XcodeIntegration.MTarget"

Property
{
	TestingWorkspace: bool = false
	MalterlibAppTestPostCopyDestination: string?
	MalterlibAppTestPostCopyProject: string?
}

%Workspace "Tests"
{
	Property
	{
		MalterlibEnableFastLink false
		TestingWorkspace true
		MalterlibAppTestPostCopyProject "Tests"
		MalterlibAppTestPostCopyDestination `TestApps/@(Target.BaseFileName)/`
		EnableTestConfigs true
		MalterlibLog_Severities ["Error", "Critical", "Warning", "Info", "Debug"]
		{
			!!MalterlibLog_EnableVerboseDebugLog false
		}
		OnlyTestConfigs true
		{
			!!OnlyTestConfigs undefined
		}
		MalterlibBuildSystemEmbedCMake false

		MalterlibTestWorkspaceExtraGroupsTemplate function(string _Test) [string] = []
		MalterlibTestWorkspaceExtraGroupsTemplate =+ MalterlibTestWorkspaceExtraGroups_@(_Test)
		{
			!!true IsDefined(`MalterlibTestWorkspaceExtraGroups_@(_Test)`)
		}
	}

	Workspace.IDEPriority 200
	Workspace.IDEDefaultBuildTarget "Com_RunAllTests"

	Workspace.ExtraGroups =+ MalterlibTests->ForEach(&MalterlibTestWorkspaceExtraGroupsTemplate)

	%Group "Tests"
	{
		%Target MalterlibTests
		{
			!!MalterlibTestAutoAddTarget true
		}
	}
	%Group "TestFramework"
	{
		%Target "Exe_RunAllTests"
		%Target "Dll_TestXcodeIntegration"
		{
			&
			{
				PlatformFamily "macOS"
				GeneratorFamily "Xcode"
				MalterlibXcodeIntegration true
			}
		}
	}
}

%Workspace MalterlibTests
{
	&
	{
		|
		{
			MalterlibSeparateTestWorkspaces true
			&
			{
				!MalterlibSeparateTestWorkspaces false
				MalterlibSeparateTestWorkspaces->ContainsListElement(Workspace:this.Identity) true
			}
		}
		MalterlibTestAutoAddWorkspace true
	}

	Property
	{
		MalterlibEnableFastLink false
		EnableTestConfigs true
		MalterlibLog_Severities ["Error", "Critical", "Warning", "Info", "Debug"]
		{
			!!MalterlibLog_EnableVerboseDebugLog false
		}
		OnlyTestConfigs true
		{
			!!OnlyTestConfigs undefined
		}

		TestingWorkspace true
		MalterlibAppTestPostCopyProject "Tests"
		MalterlibAppTestPostCopyDestination `TestApps/@(Target.BaseFileName)/`

		MalterlibBuildSystemEmbedCMake false
	}

	Workspace
	{
		Name `Test_@(Workspace:this.Identity)`
		ExtraGroups =+ MalterlibTestWorkspaceExtraGroups_@(Workspace:this.Identity)
		{
			!!true IsDefined(`MalterlibTestWorkspaceExtraGroups_@(Workspace:this.Identity)`)
		}
	}

	%Group "Tests"
	{
		%Target Workspace:this.Identity
	}
	%Group "TestFramework"
	{
		%Target "Exe_RunAllTests"
		%Target "Dll_TestXcodeIntegration"
		{
			&
			{
				PlatformFamily "macOS"
				GeneratorFamily "Xcode"
				MalterlibXcodeIntegration true
			}
		}
	}
}

%Group "{Malterlib}/{TestApp}"
{
	Property
	{
		MalterlibPostCopyProject MalterlibAppTestPostCopyProject
		{
			!MalterlibAppTestPostCopyProject undefined
		}
		MalterlibPostCopyDestination MalterlibAppTestPostCopyDestination
		{
			!MalterlibAppTestPostCopyDestination undefined
		}
	}
}

Property.MalterlibTestApp: bool = false

Target.ExtraGroups =+ "{Malterlib}/{TestApp}"
{
	!!MalterlibTestApp true
}

Property
{
	MalterlibEnablePathHelpers: bool = false
}

Target
{
	ExtraGroups =+ "~Automatic/Build Server Helpers"
	{
		!!MalterlibEnablePathHelpers true
	}
}

Property
{
	MalterlibEnableTestHelpers: bool = false

	MalterlibRunTestsParams Target:Target.DebuggerCommandArguments
	{
		!!MalterlibRunTestsParams undefined
	}

	MalterlibRunTests: bool = false

	MalterlibRunTests true
	{
		&
		{
			MalterlibRunTests undefined
			MalterlibTest true
		}
	}

	RunTestsPath MalterlibFinalModuleDestination->GetPath()

	RunTestsContents: string?
	RunTestsContents	`cd @(RunTestsPath->f_ScriptNativeEscapedPath())\r\n`\
						`@(MalterlibFinalModuleDestination->f_ScriptNativeEscapedPath()) @(MalterlibRunTestsParams)\r\n`
	{
		&
		{
			Property.MalterlibRunTests true
			Property.MalterlibEnableTestHelpers true
		}
	}
}

%Group "~Automatic/Test Helpers"
{
	!Property.RunTestsContents undefined

	Property
	{
		BuildServerHelpers_ConfigName `@(FullConfiguration->Replace(' ', ''))@((Tests || "")->Replace(' ', ''))_@(Architecture)`
	}

	%GenerateFile "Paths"
	{
		//!!Tests undefined
		GenerateFile
		{
			Name `@(BuildSystemOutputDir)/Tests/@(Workspace:Workspace.Name)/@(Target:Target.Name)/DoTests_@(BuildServerHelpers_ConfigName).@(ScriptExtension)`
			Contents `@(ScriptPreamble)@(RunTestsContents)`
			UnicodeBOM false
			UnixLineEnds ScriptUnixLineEnds
			Executable true
		}
	}
}

Target
{
	ExtraGroups =+ "~Automatic/Test Helpers"
}
