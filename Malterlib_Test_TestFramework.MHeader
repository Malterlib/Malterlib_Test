Property
{
	MalterlibTestMain "@('Tools/Tester/Source/Main.cpp'->MakeAbsolute())"

	MalterlibEnableInternalTests false // User(Tests)=true: Enable internal Malterlib tests
	{
		!!MalterlibEnableInternalTests ""
	}
	MalterlibSeparateTestWorkspaces false // User(Tests)=true: Enable generation of separate workspaces for all tests, either true for all tests, or list the test you want to be separate
	{
		!!MalterlibSeparateTestWorkspaces ""
	}
	MalterlibXcodeIntegration false // User(Tests)=true: Enable Xcode testing integration
	{
		!!MalterlibXcodeIntegration ""
	}
	MalterlibInternalTestHelperTarget true
	{
		!!"Target:Target.Name" "~*_Test_Malterlib_Helper_*"
	}
	MalterlibInternalTestTarget true
	{
		&
		{
			!MalterlibInternalTestHelperTarget true
			"Target:Target.Name" "~*_Test_Malterlib_*"
		}
	}
}

Property
{
	MalterlibTest true
	{
		&
		{
			MalterlibTest ""
			|
			{
				MalterlibHelperTest true
				MalterlibMainTest true
			}
		}
	}
}


%Target "@(MalterlibTests)"
{
	Property
	{
		MalterlibPostCopyProject "Tests"
		{
			!!MalterlibPostCopyProject ""
		}
		ProductName "Test @(Target:this.Identity->Replace('_',' '))"
		MalterlibTest true
		{
			!!MalterlibTest ""
		}
		MalterlibHelperTest true
		{
			&
			{
				MalterlibHelperTest ""
				MalterlibInternalTestHelperTarget true
			}
		}
		MalterlibMainTest true
		{
			&
			{
				MalterlibMainTest ""
				!MalterlibHelperTest true
			}
		}
		MalterlibBuildSystemEmbedCMake false
	}
	Property
	{
		!!MalterlibInternalTestTarget true
		!!MalterlibInternalTestHelperTarget true

		MalterlibExeIcon "@(Builtin.BasePathAbsolute)/Malterlib/Core/Resources/MSVC/icon1.ico"
		{
			!!PlatformFamily Windows
		}
		MalterlibMemoryManager_Debug_EnableMemoryLeaks true
		MalterlibNoShortcuts true
	}
	Target
	{
		Type "ConsoleExecutable"
		BaseName "Test_@(Target:this.Identity)"
		ExtraGroups "@(MalterlibTestExtraGroups_@(Target:this.Identity));@(MalterlibTestExtraGroups);@(Target.ExtraGroups)"
		DebuggerCommandArguments "--test"
		DebuggerCommandArguments "--test --groups Performance"
		{
			!!Tests "Perf Tests"
		}
		Group "Tests"
		{
			!!MalterlibMainTest true
		}
		Group "Helpers"
		{
			!MalterlibMainTest true
		}
	}
	Compile
	{
		!!CompileDialect "C"
		PrefixHeader "@('Tools/Tester/Source/PCH.h'->MakeAbsolute())"
		PreprocessorDefines "DMalterlibEnableThirdPartyComparisonTests;@(Compile.PreprocessorDefines)"
		{
			!!MalterlibEnableThirdPartyComparisonTests true
		}
	}
	%Group Source
	{
		%File "@(MalterlibTestMain)"
		{
			!MalterlibTestOwnMain true
		}
		%File "Tools/Tester/Source/PCH.h"
	}
	%Group Tests
	{
		%File "@(MalterlibTestFiles_@(Target:this.Identity));@(MalterlibTestFiles)"
	}
	%Dependency "@(MalterlibTestDependencies_@(Target:this.Identity));@(MalterlibTestDependencies)"
	%Dependency Lib_Malterlib
	%Dependency Lib_Malterlib_Test
}

Property
{
	MalterlibTestAutoAddTarget "@(MalterlibTestAutoAdd_@(Target:this.Identity))"
	MalterlibTestAutoAddTarget true
	{
		!!MalterlibTestAutoAddTarget ""
	}
	MalterlibTestAutoAddWorkspace "@(MalterlibTestAutoAdd_@(Workspace:this.Identity))"
	MalterlibTestAutoAddWorkspace true
	{
		!!MalterlibTestAutoAddWorkspace ""
	}
}

Import "Tools/RunAllTests/Malterlib_Test_RunAllTests.MTarget"
Import "Tools/XcodeIntegration/Malterlib_Test_XcodeIntegration.MTarget"

%Workspace "Tests"
{
	Property
	{
		MalterlibEnableFastLink false
		TestingWorkspace true
		MalterlibAppTestPostCopyProject "Tests"
		MalterlibAppTestPostCopyDestination "TestApps/@(Target.BaseFileName)/"
		EnableTestConfigs true
		MalterlibLog_Severities "Error;Critical;Warning;Info"
		{
			!!MalterlibLog_EnableVerboseDebugLog false
		}
		OnlyTestConfigs true
		{
			!!OnlyTestConfigs ""
		}
		MalterlibBuildSystemEmbedCMake false
	}

	%Group "Tests"
	{
		%Target "@(MalterlibTests)"
		{
			!!MalterlibTestAutoAddTarget true
		}
	}
	%Group "TestFramework"
	{
		%Target Exe_RunAllTests
		%Target Dll_TestXcodeIntegration
		{
			&
			{
				PlatformFamily OSX
				GeneratorFamily Xcode
				MalterlibXcodeIntegration true
			}
		}
	}
}

%Workspace "@(MalterlibTests)"
{
	&
	{
		|
		{
			MalterlibSeparateTestWorkspaces true
			MalterlibSeparateTestWorkspaces "~*@(Workspace:this.Identity)*"
		}
		MalterlibTestAutoAddWorkspace true
	}

	Property
	{
		MalterlibEnableFastLink false
		EnableTestConfigs true
		MalterlibLog_Severities "Error;Critical;Warning;Info"
		{
			!!MalterlibLog_EnableVerboseDebugLog false
		}
		OnlyTestConfigs true
		{
			!!OnlyTestConfigs ""
		}

		TestingWorkspace true
		MalterlibAppTestPostCopyProject "Tests"
		MalterlibAppTestPostCopyDestination "TestApps/@(Target.BaseFileName)/"
	}

	Workspace
	{
		Name "Test_@(Workspace:this.Identity)"
		//ExtraGroups "@(MalterlibTestWorkspaceExtraGroups_@(Target:this.Identity));@(Workspace.ExtraGroups)"
	}

	%Group Tests
	{
		%Target "@(Workspace:this.Identity)"
	}
	%Group "TestFramework"
	{
		%Target Exe_RunAllTests
		%Target Dll_TestXcodeIntegration
		{
			&
			{
				PlatformFamily OSX
				GeneratorFamily Xcode
				MalterlibXcodeIntegration true
			}
		}
	}
}

%Group "{Malterlib}/{TestApp}"
{
	Property
	{
		MalterlibPostCopyProject "@(MalterlibAppTestPostCopyProject)"
		{
			!MalterlibAppTestPostCopyProject ""
		}
		MalterlibPostCopyDestination "@(MalterlibAppTestPostCopyDestination)"
		{
			!MalterlibAppTestPostCopyDestination ""
		}
	}
}

Target.ExtraGroups "{Malterlib}/{TestApp};@(Target.ExtraGroups)"
{
	!!MalterlibTestApp true
}
