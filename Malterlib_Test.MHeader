Import "../Core/Lib_Malterlib.MTarget"

%Group "{Malterlib}/{Lib_Malterlib_Test}"
{
	%Group "Test"
	{
		%Group "Include"
		{
			Compile.Type "C++"
			{
				!!DocumentationEnabled true
			}
			%File "Include/Mib/Test/^*"
		}
		%File "Source/*"
		%Group "Documentation"
		{
			%File "Documentation/*"
		}
	}
}


Property
{
	MalterlibLibrary_Test: bool = MalterlibLibrary_All
	MalterlibSubLibraries =+ "Test"
	{
		!!MalterlibLibrary_Test true
	}
	MalterlibSubLibrarySeparate_Lib_Malterlib_Test: bool = true
	MalterlibIncludeRoots =+ "Include"->MakeAbsolute()
	{
		!!MalterlibLibrary_Test true
	}
}

Import "Malterlib_Test_TestFramework.MHeader"

Property
{
	!!MalterlibEnableInternalTests true
	
	MalterlibTests =+ "Malterlib_Test"
	MalterlibTestFiles_Malterlib_Test: [type(CEntity)] = ["Test/*"->MakeAbsolute()]
}

